+"""Bounded post-delivery meme selection for explicitly cooperating callers."""
+
+import asyncio
+import copy
+from dataclasses import dataclass
+
+from astrbot.api import logger
+from astrbot.api.provider import LLMResponse
+from astrbot.core.message.components import Image
+from astrbot.core.message.message_event_result import MessageEventResult, ResultContentType
+
+JOB_KEY = "meme_manager_deferred_job"
+TIMEOUT_SECONDS = 15
+MAX_TASKS = 32
+
+
+class SnapshotEvent:
+    """Keep worker selections/results separate from the live response pipeline."""
+
+    def __init__(self, event):
+        self.original = event
+        self.extras = copy.deepcopy(
+            {k: v for k, v in event.get_extra().items() if k.startswith("meme_manager_") and k != JOB_KEY}
+        )
+        self.extras["meme_manager_defer_selection"] = False
+        self.extras["meme_manager_deferred_worker"] = True
+        self.result = None
+        self.sender = event.get_extra("meme_manager_deferred_send")
+
+    def __getattr__(self, name):
+        return getattr(self.original, name)
+
+    def get_extra(self, key=None, default=None):
+        return self.extras if key is None else self.extras.get(key, default)
+
+    def set_extra(self, key, value):
+        self.extras[key] = value
+
+    def get_result(self):
+        return self.result
+
+    def set_result(self, result):
+        self.result = result
+
+    async def send(self, chain):
+        if await self.sender(chain) is False:
+            raise RuntimeError("Deferred delivery no longer belongs to an active context")
+
+
+@dataclass
+class DeferredReply:
+    event: SnapshotEvent
+    response: LLMResponse
+    started: bool = False
+
+
+async def run_selection(owner, job):
+    """Select and send images only; the text has already been delivered."""
+    event = job.event
+    try:
+        async with asyncio.timeout(TIMEOUT_SECONDS):
+            await owner._resp_impl(event, job.response)
+            event.set_result(MessageEventResult(chain=[], result_content_type=ResultContentType.LLM_RESULT))
+            await owner._on_decorating_result_impl(event)
+            result = event.get_result()
+            for component in result.chain if result else []:
+                if isinstance(component, Image):
+                    await owner._send_meme_image(event, component)
+            await owner._after_message_sent_impl(event)
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        # Optional media failures must not trigger a second text reply.
+        logger.warning("[meme_manager] 异步表情跳过 type=%s", type(exc).__name__)
+    finally:
+        # Do not call after_message_sent again: it could resend pending images.
+        import os
+
+        for path in event.get_extra("meme_manager_temp_files") or []:
+            try:
+                os.remove(path)
+            except OSError:
+                pass
+        event.set_extra("meme_manager_temp_files", None)
+
+
+def start_selection(owner, event):
+    job = event.get_extra(JOB_KEY)
+    if not job or job.started or not event.get_extra("meme_manager_text_delivered"):
+        return
+    job.started = True
+    tasks = getattr(owner, "_deferred_meme_tasks", None)
+    if tasks is None:
+        tasks = owner._deferred_meme_tasks = set()
+    if getattr(owner, "_deferred_meme_closing", False) or len(tasks) >= MAX_TASKS:
+        return
+    task = asyncio.create_task(run_selection(owner, job))
+    tasks.add(task)
+    task.add_done_callback(tasks.discard)
+
+
+async def close_selections(owner):
+    owner._deferred_meme_closing = True
+    tasks = list(getattr(owner, "_deferred_meme_tasks", ()))
+    for task in tasks:
+        task.cancel()
+    if tasks:
+        await asyncio.gather(*tasks, return_exceptions=True)
