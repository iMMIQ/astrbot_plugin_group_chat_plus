{
  "enable_group_chat": {
    "description": "启用原生多模态群聊",
    "type": "bool",
    "default": true
  },
  "enabled_groups": {
    "description": "启用群号；空列表表示所有群",
    "type": "list",
    "default": []
  },
  "provider_id": {
    "description": "模型 ID；留空沿用当前会话模型，必须支持图片",
    "type": "string",
    "default": ""
  },
  "input_token_budget": {
    "description": "总输入预算，包含人格、工具和图片估算",
    "type": "int",
    "default": 32768
  },
  "max_context_messages": {
    "description": "最近背景消息候选数；关联图片不受此数量截断",
    "type": "int",
    "default": 40
  },
  "context_minutes": {
    "description": "最近背景时间窗口（分钟）",
    "type": "int",
    "default": 10
  },
  "association_seconds": {
    "description": "同一发送者图片关联窗口（秒）",
    "type": "int",
    "default": 120
  },
  "max_images": {
    "description": "每次最多图片数",
    "type": "int",
    "default": 6
  },
  "background_images": {
    "description": "背景图片最多数量",
    "type": "int",
    "default": 2
  },
  "image_token_reserve": {
    "description": "单图最小 token 预留；是预算估算，不是计费承诺",
    "type": "int",
    "default": 1600
  },
  "max_image_mib": {
    "description": "单张图片字节上限（MiB）",
    "type": "int",
    "default": 10
  },
  "mention_wait_seconds": {
    "description": "纯 @ 等待同一人补发内容的时间（秒）",
    "type": "float",
    "default": 1.0
  },
  "media_wait_seconds": {
    "description": "关联附件等待时间（秒）",
    "type": "float",
    "default": 3.0
  },
  "media_retention_hours": {
    "description": "原图保留时间（小时）",
    "type": "int",
    "default": 24
  },
  "journal_retention_days": {
    "description": "事件日志保留时间（天）",
    "type": "int",
    "default": 7
  },
  "room_media_mib": {
    "description": "单群附件软配额（MiB）",
    "type": "int",
    "default": 256
  },
  "total_media_mib": {
    "description": "实例附件硬配额（MiB）",
    "type": "int",
    "default": 1024
  },
  "auto_reply_enabled": {
    "description": "允许主动插话；默认仅明确唤醒回复",
    "type": "bool",
    "default": false
  },
  "auto_candidate_probability": {
    "description": "普通消息进入统一插话判断的概率",
    "type": "float",
    "default": 0.02
  },
  "auto_reply_cooldown": {
    "description": "主动候选检查的硬冷却（秒）",
    "type": "int",
    "default": 60
  }
}
