+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from astrbot.api.provider import LLMResponse
+from astrbot.core.message.components import Image, Plain
+from astrbot.core.message.message_event_result import MessageEventResult, ResultContentType
+from astrbot_plugin_meme_manager.backend import deferred_reply
+from astrbot_plugin_meme_manager.backend.deferred_reply import JOB_KEY, close_selections
+from astrbot_plugin_meme_manager.main import MemeSender
+from astrbot_plugin_meme_manager.mixins.event_handlers import LLM_REQUEST_ORIGIN_EXTRA_KEY
+from PIL import Image as PillowImage
+
+
+@pytest.fixture
+def deferred(tmp_path):
+    sender = object.__new__(MemeSender)
+    sender.config = {"generation": {}}
+    sender.category_mapping = {"happy": "开心"}
+    sender.trigger_scope = "only_chat_llm"
+    sender.content_cleanup_rule = r"&&[a-zA-Z]*&&"
+    sender._semantic_mode_active = lambda event: False
+    sender._resolve_runtime_pack_context = lambda **kwargs: {
+        "category_mapping": sender.category_mapping,
+        "pack_dir": tmp_path,
+    }
+    sender._send_meme_image = AsyncMock()
+    sender._deferred_meme_tasks = set()
+    sender._deferred_meme_closing = False
+    sender.filter_all_tags = False
+    state = {
+        LLM_REQUEST_ORIGIN_EXTRA_KEY: "chat",
+        "meme_manager_defer_selection": True,
+        "meme_manager_deferred_send": AsyncMock(return_value=True),
+    }
+    event = SimpleNamespace(
+        get_extra=lambda key=None, default=None: state if key is None else state.get(key, default),
+        set_extra=lambda key, value: state.update({key: value}),
+        get_result=lambda: state.get("result"),
+        get_platform_name=lambda: "aiocqhttp",
+    )
+    return sender, event, state
+
+
+async def drain(sender):
+    tasks = list(sender._deferred_meme_tasks)
+    if tasks:
+        await asyncio.gather(*tasks)
+
+
+@pytest.mark.asyncio
+async def test_text_and_decorating_finish_without_selection_or_sending(deferred):
+    sender, event, state = deferred
+    sender._emotion_llm_generate = AsyncMock(side_effect=AssertionError("must not run before text"))
+    response = LLMResponse(role="assistant", completion_text="你好 &&happy&& `&&happy&&`")
+    await asyncio.wait_for(sender._resp_impl(event, response), 0.5)
+    assert response.completion_text == "你好  `&&happy&&`"
+    state["result"] = MessageEventResult(
+        chain=[Plain(response.completion_text)], result_content_type=ResultContentType.LLM_RESULT
+    )
+    await sender._on_decorating_result_impl(event)
+    await sender._after_message_sent_impl(event)  # A failed send still fires this hook in the SDK.
+    assert not sender._deferred_meme_tasks
+    sender._emotion_llm_generate.assert_not_awaited()
+    sender._send_meme_image.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_successful_text_starts_one_worker_and_preserves_snapshot(deferred):
+    sender, event, state = deferred
+    response = LLMResponse(role="assistant", completion_text="正文 &&happy&&")
+    state["meme_manager_runtime_pack_id"] = "original-pack"
+    await sender._resp_impl(event, response)
+    assert not sender._deferred_meme_tasks
+    job = state[JOB_KEY]
+    state["meme_manager_runtime_pack_id"] = "later-pack"
+    gate = asyncio.Event()
+
+    async def select(worker_event, snapshot):
+        assert worker_event.get_extra("meme_manager_runtime_pack_id") == "original-pack"
+        assert snapshot.completion_text == "正文 &&happy&&"
+        await gate.wait()
+        worker_event.set_extra("found_emotions", ["happy"])
+
+    async def decorate(worker_event):
+        worker_event.get_result().chain = [Plain("must never resend text"), Image.fromBase64("fixture")]
+
+    sender._resp_impl = select
+    sender._on_decorating_result_impl = decorate
+    state["meme_manager_text_delivered"] = True
+    await sender._after_message_sent_impl(event)
+    await sender._after_message_sent_impl(event)
+    assert len(sender._deferred_meme_tasks) == 1
+    gate.set()
+    await drain(sender)
+    sender._send_meme_image.assert_awaited_once()
+    assert sender._send_meme_image.await_args.args[0] is job.event
+    assert "found_emotions" not in state
+
+
+@pytest.mark.asyncio
+async def test_tool_intermediate_does_not_consume_final_reply(deferred):
+    sender, event, state = deferred
+    await sender._resp_impl(
+        event, LLMResponse(role="assistant", completion_text="先查询", tools_call_name=["lookup"])
+    )
+    assert JOB_KEY not in state
+    await sender._resp_impl(event, LLMResponse(role="assistant", completion_text="最终正文"))
+    assert JOB_KEY in state
+
+
+@pytest.mark.asyncio
+async def test_selection_timeout_never_sends_or_repeats_body(deferred, monkeypatch):
+    sender, event, state = deferred
+    await sender._resp_impl(event, LLMResponse(role="assistant", completion_text="正文"))
+    waiting = asyncio.Event()
+    sender._resp_impl = AsyncMock(side_effect=lambda *args: None)
+
+    async def slow(*args):
+        await waiting.wait()
+
+    sender._resp_impl = slow
+    monkeypatch.setattr(deferred_reply, "TIMEOUT_SECONDS", 0.01)
+    state["meme_manager_text_delivered"] = True
+    await sender._after_message_sent_impl(event)
+    await drain(sender)
+    sender._send_meme_image.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_refresh_cancels_workers_and_prevents_new_ones(deferred):
+    sender, event, state = deferred
+    await sender._resp_impl(event, LLMResponse(role="assistant", completion_text="正文"))
+
+    async def slow(*args):
+        await asyncio.Event().wait()
+
+    sender._resp_impl = slow
+    state["meme_manager_text_delivered"] = True
+    await sender._after_message_sent_impl(event)
+    await asyncio.sleep(0)
+    await close_selections(sender)
+    assert not sender._deferred_meme_tasks
+    sender._send_meme_image.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_deferred_image_uses_ack_callback_instead_of_global_context(deferred):
+    sender, event, state = deferred
+    sender.send_image_as_base64 = False
+    sender.context = SimpleNamespace(send_message=AsyncMock())
+    state["meme_manager_deferred_worker"] = True
+    event.send = AsyncMock()
+    await MemeSender._send_meme_image(sender, event, Image.fromBase64("fixture"))
+    event.send.assert_awaited_once()
+    sender.context.send_message.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("probability", [0, 100])
+async def test_real_legacy_selection_runs_after_ack_only(deferred, tmp_path, probability):
+    sender, event, state = deferred
+    directory = tmp_path / "happy"
+    directory.mkdir()
+    PillowImage.new("RGB", (2, 2)).save(directory / "fixture.png")
+    sender.emotions_probability = probability
+    sender.emotion_llm_enabled = True
+    sender.remove_invalid_alternative_markup = False
+    sender.convert_static_to_gif = False
+    sender.enable_mixed_message = False
+    sender.send_image_as_base64 = False
+    sender._get_runtime_memes_dir_for_event = lambda event: tmp_path
+    sender._emotion_llm_generate = AsyncMock(
+        return_value=LLMResponse(role="assistant", completion_text='{"emotions":["happy"]}')
+    )
+    response = LLMResponse(role="assistant", completion_text="正文")
+    await sender._resp_impl(event, response)
+    sender._emotion_llm_generate.assert_not_awaited()
+    state["meme_manager_text_delivered"] = True
+    await sender._after_message_sent_impl(event)
+    await drain(sender)
+    assert sender._send_meme_image.await_count == (1 if probability else 0)
+    assert response.completion_text == "正文"
